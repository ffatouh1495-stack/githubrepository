srchm = 0,           // no search or optimization
ioflag = 3,           // metric input / metric output
ipro = -1,           // print final trajectory only
opt = 0,             // no optimization
title = 'Phase0 rigid_d4.5_m900',
event = 1,            // event or phase number
fesn = 100,           // final event number
maxtim = 5000.0,      // maximum allowable time
altmax = 5.0e6,       // maximum allowable altitude
pinc = 1,             // print interval (fine, for peak-search/heat-load integration)
prnc = 1,             // plot interval
dt = 1.0,             // integration time step
npc(1) = 3,           // calculate conics at end of each integ. step
npc(2) = 1,           // fourth order runge-kutta
// Input initial position
npc(4) = 2,           // position vector initialization flag
gdalt = 125000.0,     // initial geodetic altitude (entry interface)
long = 100.0,         // initial east long. relative to prime meridian (arbitrary, fixed across grid)
gclat = 40.0,         // initial geocentric latitude (arbitrary, fixed across grid)
// Input velocity vector
npc(3) = 2,           // input gammai, veli, azveli
gammai = -15.49,       // initial inertial flight path angle (MSL value; re-check feasibility per scenario)
azveli = 90.0,        // initial azimuth angle of inert. vel. vector
veli = 5900.0,        // initial value of inertial velocity
// Mars atmosphere + wind
// >>> PLACEHOLDER -- Mars atmosphere/wind syntax not yet confirmed.
// >>> This reference file is NOT runnable as-is. See
// >>> mars_environment.py for why, and README.md for status.
// >>> wind_speed_mps=10.0, wind_direction_deg=0.0
// Model planetary gravity (Mars)
npc(16) = 2,          // oblate planet model
omega = 7.088218e-05,   // rotation rate of attracting planet
mu = 42828370000000.0,      // gravitational constant of attracting planet
re = 3396200.0,     // equatorial radius of planet
rp = 3376200.0,     // polar radius of planet
re_grav = 3396200.0, // reference radius of planet for the gravity model
j2 = 0.001960454,   // Mars J2 (higher-order terms not modeled -- Phase 0 simplification)
// Input vehicle characteristics -- Phase 1 (entry, full aeroshell)
wgtsg = 31975.787703,   // (N) entry weight = entry_mass * standard g
sref = 15.904313,          // (sq m) reference area = pi*(d/2)^2, d=4.5 m
lref = 4.5,              // (m) reference length = diameter
npc(8) = 2,           // use drag, lift, & side force coefficients
cdt = 'cdt', monovar, mach, 0, lin_inp, xtrap,
0.0, 0.7500,  0.2, 0.7800,  0.4, 0.8500,  0.6, 1.0000,
0.8, 1.2500,  0.9, 1.3800,  1.0, 1.4200,  1.2, 1.4000,
1.5, 1.3800,  2.0, 1.3600,  2.5, 1.3800,  3.0, 1.4000,
4.0, 1.4100,  5.0, 1.4200,  10.0, 1.4200,  30.0, 1.4200,
clt = 'clt', monovar, mach, 0, lin_inp, xtrap,
0.0, 0.1800,  0.2, 0.1872,  0.4, 0.2040,  0.6, 0.2400,
0.8, 0.3000,  0.9, 0.3312,  1.0, 0.3408,  1.2, 0.3360,
1.5, 0.3312,  2.0, 0.3264,  2.5, 0.3312,  3.0, 0.3360,
4.0, 0.3384,  5.0, 0.3408,  10.0, 0.3408,  30.0, 0.3408,
event = 50,           // jettison / decelerator-deploy trigger
critr = 'dynp',       // dynamic-pressure based trigger (NOT altitude or time, per spec)
value = 750.0,   // Pa, representative rigid deploy dynamic pressure
mdl = 1,              // ignore the sign of the deriv. of critr
wgtsg = 8825.985000,   // (N) post-jettison weight = payload_mass * standard g
cdt = 'cdt', constant, 0, 2.0,   // post-jettison drag (Phase 0 stand-in, not real parachute geometry)
clt = 'clt', constant, 0, 0.0,   // post-jettison lift (Phase 0: none modeled)
event = 100,          // touchdown
critr = 'gdalt',
value = 0.0,
mdl = 1,
endprb = 1,
endjob = 1,
