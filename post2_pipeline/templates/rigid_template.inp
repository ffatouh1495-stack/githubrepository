srchm = 0,           // no search or optimization
ioflag = 3,           // metric input / metric output
ipro = -1,           // print final trajectory only
opt = 0,             // no optimization
title = 'Phase0 rigid_d4.5_m900',
event = 1,            // event or phase number
fesn = 100,           // final event number
maxtim = 5000.0,      // maximum allowable time
altmax = 5.0e6,       // maximum allowable altitude (skip-out catch)
altmin = -2055.0,    // PENDING verify: global safety-net so a run
                      // that never separates the heat shield still stops at
                      // the handoff altitude instead of falling through --
                      // see generate_input.py module docstring
pinc = 1,             // print interval (fine, for later analysis)
prnc = 1,             // plot interval
dt = 1.0,             // integration time step
npc(1) = 3,           // calculate conics at end of each integ. step
npc(2) = 1,           // fourth order runge-kutta
// Fixed entry state -- SAME for all 32 scenarios, per spec
// (Brandenburg et al., Table 1 'MSL Entry Interface State')
npc(4) = 2,           // position vector initialization flag
gdalt = 133000.0,     // initial geodetic altitude (133.0 km, NOT 125 km -- see README)
long = 126.72,        // initial east longitude
gclat = -3.872746729711164,  // PENDING verify: geocentric-latitude equivalent of
                      // the sourced GDLAT=-3.9186 -- see config.py
npc(3) = 2,           // input gammai, veli, azveli (inertial)
gammai = -15.489,     // initial inertial flight path angle
azveli = 93.2065,     // initial inertial heading
veli = 6080.1504,    // initial inertial velocity
// Mars atmosphere + wind
// >>> PLACEHOLDER -- Mars atmosphere table (NPC(5)=1 / PREST /
// >>> ATEMT / CST / DENST) and wind table (NPC(6) / VWT / AZW_T)
// >>> syntax not yet confirmed, and mars_atmosphere_gale.csv not
// >>> yet supplied. This reference file is NOT runnable as-is.
// >>> See mars_environment.py and README.md for status.
// >>> wind_speed_mps=10.0, wind_direction_deg=0.0
// Model planetary gravity (Mars)
npc(16) = 2,          // oblate planet model
omega = 7.088218e-05,   // rotation rate of attracting planet
mu = 42828370000000.0,      // gravitational constant of attracting planet
re = 3396190.0,     // equatorial radius of planet
rp = 3376200.0,     // polar radius of planet
re_grav = 3396190.0, // PENDING verify: reference radius for the gravity model
j2 = 0.00196045,   // Mars J2
j3 = 0.0, j4 = 0.0, j5 = 0.0, j6 = 0.0, j7 = 0.0, j8 = 0.0, // higher terms not modeled for Mars
// Input vehicle characteristics -- Phase 1 (entry, full vehicle + aeroshell)
wgtsg = 31950.065700,   // (N) total entry weight = total_mass * standard g
sref = 15.904313,          // (sq m) reference area = pi*(d/2)^2, d=4.5 m
lref = 4.5,              // (m) reference length = diameter
npc(8) = 2,           // use drag, lift, & side force coefficients
cdt = 'cdt', monovar, mach, 0, lin_inp, xtrap,
0.0, 1.4640,  1.7, 1.4640,  2.06, 1.4640,  2.27, 1.4180,
2.5, 1.4070,  2.8, 1.3840,  3.0, 1.3840,  3.5, 1.3850,
4.0, 1.3740,  5.0, 1.3840,  6.0, 1.3900,  7.0, 1.3900,
8.0, 1.3920,  8.9, 1.4020,  9.9, 1.4070,  12.0, 1.4180,
14.0, 1.4330,  16.0, 1.4460,  18.1, 1.4540,  20.0, 1.4590,
22.5, 1.4590,  25.0, 1.4600,  30.0, 1.4600,
clt = 'clt', monovar, mach, 0, lin_inp, xtrap,
0.0, 0.0000,  1.7, 0.0000,  2.06, 0.4246,  2.27, 0.4106,
2.5, 0.4067,  2.8, 0.3991,  3.0, 0.3985,  3.5, 0.3973,
4.0, 0.3927,  5.0, 0.3925,  6.0, 0.3912,  7.0, 0.3881,
8.0, 0.3857,  8.9, 0.3857,  9.9, 0.3840,  12.0, 0.3805,
14.0, 0.3783,  16.0, 0.3754,  18.1, 0.3708,  20.0, 0.3661,
22.5, 0.3581,  25.0, 0.3504,  30.0, 0.3504,
bnkpc = 'bnkpc', constant, 0, 15.0,   // PENDING verify: fixed bank angle syntax + sign convention
event = 50,           // parachute deployment
critr = 'mach',       // Mach-number trigger (NOT altitude or time), per spec
value = 1.7,   // MSL's real chute-deploy Mach (Karlgaard et al.)
mdl = 1,              // ignore the sign of the deriv. of critr
// Post-chute drag = chute (S0=358.050 sq m, D0=21.351 m) + body, combined
// into one effective CD table referenced to the body's SREF -- see
// aero_data.combined_post_chute_cd_table() for the derivation.
cdt = 'cdt', monovar, mach, 0, lin_inp, xtrap,
0.0, 15.4219,  0.8, 15.4219,  0.95, 12.4952,  1.5, 18.3486,
1.7, 17.2025,
clt = 'clt', constant, 0, 0.0,   // lift ends at chute deploy, per spec
bnkpc = 'bnkpc', constant, 0, 0.0,   // bank moot once CL=0, zeroed for clarity
event = 70,           // heat shield (aeroshell) separation
critr = 'mach',
value = 0.7,   // MSL's real heat-shield-sep Mach (Karlgaard et al.)
mdl = 1,
wgtsg = 28174.505450,   // (N) weight after dropping the author-assumed
                       // 385.0 kg heat-shield/aeroshell mass
event = 100,          // powered-descent handoff
critr = 'gdalt',
value = -2055.0,    // 1.7 km above the Gale local surface (-3755.0 m areoid-referenced)
mdl = 1,
endprb = 1,
endjob = 1,
