bnkang = 60.0,   // deg; CONFIRMED WORKING against a real run (max_abs_bnkang_deg
                      // = 15.0 printed in the actual trajectory, after two earlier syntax
                      // guesses -- bare `bnkpc = <val>,` and indexed `bnkpc(1) = <val>,` --
                      // were both silently accepted by POST2 but had zero effect). The fix is
                      // BOTH lines together: the direct initial value here (manual:
                      // ALPHA/BETA/BNKANG) AND the full 4-value BNKPC array literal below
                      // (manual: BNKPC(i), i=1,4, decimal, default 0.0), NOT indexed element
                      // access -- POST2's free-form parser wants the whole array assigned at
                      // once. Sign convention: manual states positive BNKANG banks right;
                      // doesn't affect vertical-plane behavior (peak g, skip, Mach-1.7 state),
                      // only lateral drift.
bnkpc = 60.0, 0.0, 0.0, 0.0,   // deg; full array literal (constant, linear, quadratic, cubic terms)
event = 50,           // parachute deployment
critr = 'mach',       // Mach-number trigger (NOT altitude or time), per spec
value = 1.7,   // MSL's real chute-deploy Mach (Karlgaard et al.)
mdl = 1,              // ignore the sign of the deriv. of critr
// Post-chute drag = chute (S0=456.959 sq m, D0=24.121 m) + body, combined
// into one effective CD table referenced to the body's SREF -- see
// aero_data.combined_post_chute_cd_table() for the derivation (unit-independent ratio).
cdt = 'cdt', monovar, mach, 0, lin_inp, xtrap,
0.0, 5.9174,  0.8, 5.9174,  0.95, 4.9836,  1.5, 6.8512,
1.7, 6.4855,
clt = 'clt', constant, 0, 0.0,   // lift ends at chute deploy, per spec
bnkang = 0.0,   // bank moot once CL=0, zeroed for clarity
bnkpc = 0.0, 0.0, 0.0, 0.0,   // deg; full array literal, see the event-1 bnkpc line above
event = 70,           // heat shield (aeroshell) separation
critr = 'mach',
value = 0.7,   // MSL's real heat-shield-sep Mach (Karlgaard et al.)
mdl = 1,
wgtsg = 8318.041152,   // lbf; weight after dropping the author-assumed
                       // 385.0 kg heat-shield/aeroshell mass
event = 100,          // powered-descent handoff
critr = 'gdalt',
value = -6742.13,    // ft; 1.7 km above the Gale local surface (-3755.0 m areoid-referenced)
mdl = 1,
endprb = 1,
endjob = 1,
